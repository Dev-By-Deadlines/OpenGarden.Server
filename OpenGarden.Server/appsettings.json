{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:5002",
    "Audience": "http://localhost:5002",
    "AccessTokenExpirationInMinutes": 10,
    "RefreshTokenExpirationInDays": 7
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "GuestCreationPermitLimit": 2
  }
}
